# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/racehorse?schema=public
# Used only by `prisma migrate deploy`/`migrate dev`. On a plain Postgres
# (local dev) this is the same as DATABASE_URL. On Neon (or any pooled
# connection, e.g. PgBouncer) this MUST be the *unpooled* connection string
# — migrations need a session-level advisory lock that poolers don't
# support, and time out otherwise (P1002).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/racehorse?schema=public

# JWT — generate long random strings for real use
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_REFRESH_TTL=7d

# Frontend base URL (used to build links in emails)
APP_WEB_URL=http://localhost:5173

# Email (Brevo HTTP API — not SMTP; some PaaS free tiers block outbound
# SMTP connections). Leave blank to disable sending, no error — emails are
# just logged to console instead. See docs/DEPLOY.md "Gửi email" for setup.
# MAIL_FROM must be a sender verified in your Brevo account (Brevo has no
# shared test domain like Resend's onboarding@resend.dev).
BREVO_API_KEY=
MAIL_FROM="Racehorse Club <your-verified-sender@gmail.com>"

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# Google OAuth (Sign in with Google) — leave blank to disable the button,
# no error. See docs/DEPLOY.md "Đăng nhập Google" for how to create one.
GOOGLE_CLIENT_ID=

# AI horse-insight assistant (Groq, hosts open-weight models e.g. Llama 3.3).
# Leave blank to disable — the "Phân tích AI" button will show an error.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
